<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: in-app update download (DownloadManager) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Microphone for voice recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Audio file access for older devices; Android 13+ uses the system file picker (no permission needed) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Optional notifications (recording/export complete) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Microphone is optional: the app runs fully without it -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:label="RuhMix"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!-- AdMob App ID (res/values/ads.xml me — Hasnain ka real ID). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="RuhMix"
            android:theme="@style/RuhMix.Splash"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares files from the private cache dir via the system chooser -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ruhmix.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
