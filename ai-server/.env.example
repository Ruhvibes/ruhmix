# Copy to .env before first run:  cp .env.example .env
#
# API_KEY: leave empty — the server generates a random key on first run,
# prints it once to the logs, and saves it back to .env (when writable).
# Set it explicitly here for production / RunPod / Vast.ai deploys.
API_KEY=

# Job files (uploads, stems, zips) are auto-deleted after this many hours.
RETENTION_HOURS=24

# Max upload size in megabytes (413 if exceeded).
MAX_UPLOAD_MB=200

# HTTP port (host mapping in docker-compose.yml follows this too).
PORT=8000

# Optional overrides:
# MODEL_NAME=htdemucs
# JOBS_DIR=jobs
# DOCS_ENABLED=1   # set to 0 in production to hide /docs + /openapi.json
